                                                },
                                                "children": [
                                                    {
                                                        "type": "basic",
                                                        "name": "Label",
                                                        "props": {
                                                            "className": "form-label",
                                                            "htmlFor": "badge_icon"
                                                        },
                                                        "text": "배지 아이콘"
                                                    },
                                                    {
                                                        "type": "basic",
                                                        "name": "P",
                                                        "props": {
                                                            "className": "form-hint"
                                                        },
                                                        "text": "이미지 위 배지 이모지"
                                                    }
                                                ]
                                            },
                                            {
                                                "type": "basic",
                                                "name": "Input",
                                                "props": {
                                                    "id": "badge_icon",
                                                    "name": "badge_icon",
                                                    "type": "text",
                                                    "className": "lg:col-span-1 form-input"
                                                }
                                            }
                                        ]
                                    },
                                    {
                                        "id": "field_badge_label",
                                        "type": "basic",
                                        "name": "Div",
                                        "props": {
                                            "className": "grid-2col lg:grid-cols-3 items-center px-6 py-4"
                                        },
                                        "children": [
                                            {
                                                "type": "basic",
                                                "name": "Div",
                                                "props": {
                                                    "className": "lg:col-span-2"
                                                },
                                                "children": [
                                                    {
                                                        "type": "basic",
                                                        "name": "Label",
                                                        "props": {
                                                            "className": "form-label",
                                                            "htmlFor": "badge_label"
                                                        },
                                                        "text": "배지 글자"
                                                    },
                                                    {
                                                        "type": "basic",
                                                        "name": "P",
                                                        "props": {
                                                            "className": "form-hint"
                                                        },
                                                        "text": "마우스 오버 시 글자"
                                                    }
                                                ]
                                            },
                                            {
                                                "type": "basic",
                                                "name": "Input",
                                                "props": {
                                                    "id": "badge_label",
                                                    "name": "badge_label",
                                                    "type": "text",
                                                    "className": "lg:col-span-1 form-input"
                                                }
                                            }
                                        ]
                                    },
                                    {
                                        "id": "field_badge_order",
                                        "type": "basic",
                                        "name": "Div",
                                        "props": {
                                            "className": "grid-2col lg:grid-cols-3 items-center px-6 py-4"
                                        },
                                        "children": [
                                            {
                                                "type": "basic",
                                                "name": "Div",
                                                "props": {
                                                    "className": "lg:col-span-2"
                                                },
                                                "children": [
                                                    {
                                                        "type": "basic",
                                                        "name": "Label",
                                                        "props": {
                                                            "className": "form-label",
                                                            "htmlFor": "badge_order"
                                                        },
                                                        "text": "PDF 정렬 번호"
                                                    },
                                                    {
                                                        "type": "basic",
                                                        "name": "P",
                                                        "props": {
                                                            "className": "form-hint"
                                                        },
                                                        "text": "작을수록 위에 표시됩니다. 0~999"
                                                    }
                                                ]
                                            },
                                            {
                                                "type": "basic",
                                                "name": "Input",
                                                "props": {
                                                    "id": "badge_order",
                                                    "name": "badge_order",
                                                    "type": "number",
                                                    "className": "lg:col-span-1 form-input"
                                                }
                                            }
                                        ]
                                    },
                                    {
                                        "id": "field_default_scale",
                                        "type": "basic",
                                        "name": "Div",
                                        "props": {
                                            "className": "grid-2col lg:grid-cols-3 items-center px-6 py-4"
                                        },
                                        "children": [
                                            {
                                                "type": "basic",
                                                "name": "Div",
                                                "props": {
                                                    "className": "lg:col-span-2"
                                                },
                                                "children": [
                                                    {
                                                        "type": "basic",
                                                        "name": "Label",
                                                        "props": {
                                                            "className": "form-label",
                                                            "htmlFor": "default_scale"
                                                        },
                                                        "text": "기본 배율"
                                                    },
                                                    {
                                                        "type": "basic",
                                                        "name": "P",
                                                        "props": {
                                                            "className": "form-hint"
                                                        },
                                                        "text": "0.5 ~ 3.0"
                                                    }
                                                ]
                                            },
                                            {
                                                "type": "basic",
                                                "name": "Input",
                                                "props": {
                                                    "id": "default_scale",
                                                    "name": "default_scale",
                                                    "type": "number",
                                                    "className": "lg:col-span-1 form-input"
                                                }
                                            }
                                        ]
                                    },
                                    {
                                        "id": "field_wheel_scroll_px",
                                        "type": "basic",
                                        "name": "Div",
                                        "props": {
                                            "className": "grid-2col lg:grid-cols-3 items-center px-6 py-4"
                                        },
                                        "children": [
                                            {
                                                "type": "basic",
                                                "name": "Div",
                                                "props": {
                                                    "className": "lg:col-span-2"
                                                },
                                                "children": [
                                                    {
                                                        "type": "basic",
                                                        "name": "Label",
                                                        "props": {
                                                            "className": "form-label",
                                                            "htmlFor": "wheel_scroll_px"
                                                        },
                                                        "text": "휠 스크롤 양 (px)"
                                                    },
                                                    {
                                                        "type": "basic",
                                                        "name": "P",
                                                        "props": {
                                                            "className": "form-hint"
                                                        },
                                                        "text": "작을수록 천천히 스크롤"
                                                    }
                                                ]
                                            },
                                            {
                                                "type": "basic",
                                                "name": "Input",
                                                "props": {
                                                    "id": "wheel_scroll_px",
                                                    "name": "wheel_scroll_px",
                                                    "type": "number",
                                                    "className": "lg:col-span-1 form-input"
                                                }
                                            }
                                        ]
                                    },
                                    {
                                        "id": "field_show_print",
                                        "type": "basic",
                                        "name": "Div",
                                        "props": {
                                            "className": "grid-2col lg:grid-cols-3 items-center px-6 py-4"
                                        },
                                        "children": [
                                            {
                                                "type": "basic",
                                                "name": "Div",
                                                "props": {
                                                    "className": "lg:col-span-2"
                                                },
                                                "children": [
                                                    {
                                                        "type": "basic",
                                                        "name": "Label",
                                                        "props": {
                                                            "className": "form-label"
                                                        },
                                                        "text": "인쇄 버튼"
                                                    }
                                                ]
                                            },
                                            {
                                                "type": "basic",
                                                "name": "Div",
                                                "props": {
                                                    "className": "lg:col-span-1 flex justify-end"
                                                },
                                                "children": [
                                                    {
                                                        "type": "composite",
                                                        "name": "Toggle",
                                                        "props": {
                                                            "name": "show_print"
                                                        }
                                                    }
                                                ]
                                            }
                                        ]
                                    },
                                    {
                                        "id": "field_show_download",
                                        "type": "basic",
                                        "name": "Div",
                                        "props": {
                                            "className": "grid-2col lg:grid-cols-3 items-center px-6 py-4"
                                        },
                                        "children": [
                                            {
                                                "type": "basic",
                                                "name": "Div",
                                                "props": {
                                                    "className": "lg:col-span-2"
                                                },
                                                "children": [
                                                    {
                                                        "type": "basic",
                                                        "name": "Label",
                                                        "props": {
                                                            "className": "form-label"
                                                        },
                                                        "text": "다운로드 버튼"
                                                    }
                                                ]
                                            },
                                            {
                                                "type": "basic",
                                                "name": "Div",
                                                "props": {
                                                    "className": "lg:col-span-1 flex justify-end"
                                                },
                                                "children": [
                                                    {
                                                        "type": "composite",
                                                        "name": "Toggle",
                                                        "props": {
                                                            "name": "show_download"
                                                        }
                                                    }
                                                ]
                                            }
                                        ]
                                    },
                                    {
                                        "id": "field_show_zoom",
                                        "type": "basic",
                                        "name": "Div",
                                        "props": {
                                            "className": "grid-2col lg:grid-cols-3 items-center px-6 py-4"
                                        },
                                        "children": [
                                            {
                                                "type": "basic",
                                                "name": "Div",
                                                "props": {
                                                    "className": "lg:col-span-2"
                                                },
                                                "children": [
                                                    {
                                                        "type": "basic",
                                                        "name": "Label",
                                                        "props": {
                                                            "className": "form-label"
                                                        },
                                                        "text": "확대/축소"
                                                    }
                                                ]
                                            },
                                            {
                                                "type": "basic",
                                                "name": "Div",
                                                "props": {
                                                    "className": "lg:col-span-1 flex justify-end"
                                                },
                                                "children": [
                                                    {
                                                        "type": "composite",
                                                        "name": "Toggle",
                                                        "props": {
                                                            "name": "show_zoom"
                                                        }
                                                    }
                                                ]
                                            }
                                        ]
                                    },
                                    {
                                        "id": "field_show_page_thumbs",
                                        "type": "basic",
                                        "name": "Div",
                                        "props": {
                                            "className": "grid-2col lg:grid-cols-3 items-center px-6 py-4"
                                        },
                                        "children": [
                                            {
                                                "type": "basic",
                                                "name": "Div",
                                                "props": {
                                                    "className": "lg:col-span-2"
                                                },
                                                "children": [
                                                    {
                                                        "type": "basic",
                                                        "name": "Label",
                                                        "props": {
                                                            "className": "form-label"
                                                        },
                                                        "text": "페이지 미리보기"
                                                    }
                                                ]
                                            },
                                            {
                                                "type": "basic",
                                                "name": "Div",
                                                "props": {
                                                    "className": "lg:col-span-1 flex justify-end"
                                                },
                                                "children": [
                                                    {
                                                        "type": "composite",
                                                        "name": "Toggle",
                                                        "props": {
                                                            "name": "show_page_thumbs"
                                                        }
                                                    }
                                                ]
                                            }
                                        ]
                                    },
                                    {
                                        "id": "field_show_file_rail",
                                        "type": "basic",
                                        "name": "Div",
                                        "props": {
                                            "className": "grid-2col lg:grid-cols-3 items-center px-6 py-4"
                                        },
                                        "children": [
                                            {
                                                "type": "basic",
                                                "name": "Div",
                                                "props": {
                                                    "className": "lg:col-span-2"
                                                },
                                                "children": [
                                                    {
                                                        "type": "basic",
                                                        "name": "Label",
                                                        "props": {
                                                            "className": "form-label"
                                                        },
                                                        "text": "파일 목록 슬라이더"
                                                    }
                                                ]
                                            },
                                            {
                                                "type": "basic",
                                                "name": "Div",
                                                "props": {
                                                    "className": "lg:col-span-1 flex justify-end"
                                                },
                                                "children": [
                                                    {
                                                        "type": "composite",
                                                        "name": "Toggle",
                                                        "props": {
                                                            "name": "show_file_rail"
                                                        }
                                                    }
                                                ]
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "id": "footer_buttons",
                        "type": "basic",
                        "name": "Div",
                        "props": {
                            "className": "sticky-footer-buttons"
                        },
                        "children": [
                            {
                                "id": "cancel_button",
                                "type": "basic",
                                "name": "Button",
                                "props": {
                                    "type": "button",
                                    "className": "btn btn-secondary"
                                },
                                "actions": [
                                    {
                                        "type": "click",
                                        "handler": "navigate",
                                        "params": {
                                            "path": "/admin/plugins"
                                        }
                                    }
                                ],
                                "children": [
                                    {
                                        "type": "basic",
                                        "name": "Span",
                                        "text": "$t:common.cancel"
                                    }
                                ]
                            },
                            {
                                "id": "save_button",
                                "type": "basic",
                                "name": "Button",
                                "props": {
                                    "type": "button",
                                    "disabled": "{{!_local.hasChanges || _local.isSaving}}",
                                    "className": "btn btn-primary flex-center gap-1.5"
                                },
                                "actions": [
                                    {
                                        "type": "click",
                                        "handler": "sequence",
                                        "actions": [
                                            {
                                                "handler": "setState",
                                                "params": {
                                                    "target": "local",
                                                    "isSaving": true,
                                                    "errors": null
                                                }
                                            },
                                            {
                                                "handler": "apiCall",
                                                "auth_required": true,
                                                "target": "/api/plugins/custom-viewer_pdf/admin/settings",
                                                "params": {
                                                    "method": "PUT",
                                                    "body": "{{_local.form}}"
                                                },
                                                "onSuccess": [
                                                    {
                                                        "handler": "setState",
                                                        "params": {
                                                            "target": "local",
                                                            "isSaving": false,
                                                            "hasChanges": false
                                                        }
                                                    },
                                                    {
                                                        "handler": "toast",
                                                        "params": {
                                                            "type": "success",
                                                            "message": "$t:admin.plugins.settings.save_success"
                                                        }
                                                    },
                                                    {
                                                        "handler": "refetchDataSource",
                                                        "params": {
                                                            "dataSourceId": "settings"
                                                        }
                                                    }
                                                ],
                                                "onError": [
                                                    {
                                                        "handler": "setState",
                                                        "params": {
                                                            "target": "local",
                                                            "isSaving": false,
                                                            "errors": "{{error.errors}}"
                                                        }
                                                    },
                                                    {
                                                        "handler": "toast",
                                                        "params": {
                                                            "type": "error",
                                                            "message": "{{error.message ?? '$t:admin.plugins.settings.save_error'}}"
                                                        }
                                                    }
                                                ]
                                            }
                                        ]
                                    }
                                ],
                                "children": [
                                    {
                                        "type": "basic",
                                        "name": "Span",
                                        "if": "{{!_local.isSaving}}",
                                        "text": "$t:common.save"
                                    },
                                    {
                                        "type": "basic",
                                        "name": "Span",
                                        "if": "{{_local.isSaving}}",
                                        "text": "$t:common.saving"
                                    }
                                ]
                            }
                        ]
                    }
                ]
            }
        ]
    },
    "schema": {
        "badge_icon": {
            "type": "string",
            "default": "📄"
        },
        "badge_label": {
            "type": "string",
            "default": "PDF"
        },
        "badge_order": {
            "type": "integer",
            "default": 20
        },
        "default_scale": {
            "type": "number",
            "default": 1.15
        },
        "wheel_scroll_px": {
            "type": "integer",
            "default": 140
        },
        "show_print": {
            "type": "boolean",
            "default": true
        },
        "show_download": {
            "type": "boolean",
            "default": true
        },
        "show_zoom": {
            "type": "boolean",
            "default": true
        },
        "show_page_thumbs": {
            "type": "boolean",
            "default": true
        },
        "show_file_rail": {
            "type": "boolean",
            "default": true
        }
    },
    "init_actions": [
        {
            "handler": "setState",
            "params": {
                "target": "local",
                "form.schedules": "{{Array.isArray(_local.form.schedules) ? _local.form.schedules : [{enabled:true,effect:(_local.form.effect ?? \"snow\"),intensity:(_local.form.intensity ?? 100),speed:(_local.form.speed ?? 100),opacity:(_local.form.opacity ?? 75),wind:(_local.form.wind ?? 0),wind_direction:(_local.form.wind_direction ?? \"none\"),color:(_local.form.color ?? \"#ffffff\"),start_date:(_local.form.schedule_start_date ?? \"\"),end_date:(_local.form.schedule_end_date ?? \"\"),start_time:(_local.form.schedule_start_time ?? \"\"),end_time:(_local.form.schedule_end_time ?? \"\"),timezone:(_local.form.schedule_timezone ?? \"Asia/Seoul\"),sun:(_local.form.schedule_days !== \"weekdays\"),mon:(_local.form.schedule_days !== \"weekends\"),tue:(_local.form.schedule_days !== \"weekends\"),wed:(_local.form.schedule_days !== \"weekends\"),thu:(_local.form.schedule_days !== \"weekends\"),fri:(_local.form.schedule_days !== \"weekends\"),sat:(_local.form.schedule_days !== \"weekdays\")}]}}"
            }
        }
    ],
    "components": []
}
