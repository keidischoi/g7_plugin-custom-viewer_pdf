{
    "version": "1.0.0",
    "layout_name": "plugin_settings",
    "permissions": [
        "core.plugins.update"
    ],
    "extends": "_admin_base",
    "meta": {
        "title": "PDF 뷰어 설정",
        "description": "배지, 버튼, 휠 스크롤 양을 관리합니다."
    },
    "data_sources": [
        {
            "id": "settings",
            "label_key": "$t:custom-viewer_pdf.editor.data_source.settings",
            "type": "api",
            "endpoint": "/api/plugins/custom-viewer_pdf/admin/settings",
            "method": "GET",
            "auto_fetch": true,
            "auth_required": true,
            "initLocal": "form",
            "refetchOnMount": true
        }
    ],
    "slots": {
        "content": [
            {
                "id": "plugin_settings_content",
                "type": "basic",
                "name": "Div",
                "dataKey": "form",
                "trackChanges": true,
                "props": {
                    "className": "admin-page-content-responsive"
                },
                "children": [
                    {
                        "id": "page_header",
                        "type": "composite",
                        "name": "PageHeader",
                        "props": {
                            "title": "PDF 뷰어 설정",
                            "description": "배지, 버튼, 휠 스크롤 양을 관리합니다.",
                            "backPath": "/admin/plugins",
                            "backLabel": "$t:admin.plugins.back_to_list"
                        }
                    },
                    {
                        "id": "settings_notice",
                        "type": "basic",
                        "name": "Div",
                        "props": {
                            "className": "mt-6 rounded-lg border border-blue-200 bg-blue-50 px-4 py-3 text-sm text-blue-800 dark:border-blue-800 dark:bg-blue-950 dark:text-blue-200"
